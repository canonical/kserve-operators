apiVersion: v1
kind: Service
metadata:
  name: {{ app_name }}-webhooks
  namespace: {{ namespace }}
spec:
  ports:
  - name: https
    port: 443
    protocol: TCP
    targetPort: 9443
  - name: metrics
    port: 8080
    protocol: TCP
    targetPort: {{ webhook_metrics_port }}
  selector:
    app.kubernetes.io/name: {{ app_name }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app_name }}-metrics-apiserver
  namespace: {{ namespace }}
spec:
  ports:
  - name: https
    port: 443
    targetPort: 6443
  - name: metrics
    port: 8080
    targetPort: {{ adapter_metrics_port }}
  selector:
    app.kubernetes.io/name: {{ app_name }}
