{%- set needs_storage_initializer = is_s3 or use_hf_token %}
{% if is_s3 %}
apiVersion: v1
kind: Secret
metadata:
  name: {{ s3_secret_name }}
  namespace: {{ namespace }}
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "{{ s3_access_key }}"
  AWS_SECRET_ACCESS_KEY: "{{ s3_secret_access_key }}"
---
{% elif use_hf_token %}
apiVersion: v1
kind: Secret
metadata:
  name: {{ hf_secret_name }}
  namespace: {{ namespace }}
type: Opaque
stringData:
  HF_TOKEN: "{{ hf_token }}"
---
{% endif %}
apiVersion: serving.kserve.io/v1alpha2
kind: LLMInferenceService
metadata:
  name: {{ app_name }}
  namespace: {{ namespace }}
spec:
  model:
    uri: {{ model_uri }}
    name: {{ model_name }}
{% if needs_storage_initializer %}
  storageInitializer:
    enabled: false
{% endif %}
  replicas: 1
  router:
    scheduler: {}
    route: {}
  template:
{% if needs_storage_initializer %}
    volumes:
      - name: kserve-pvc-source
        emptyDir: {}
    initContainers:
      - name: storage-initializer
        image: {{ storage_initializer_image }}
        args:
          - {{ model_uri }}
          - /mnt/models
        env:
{% if is_s3 %}
          - name: AWS_ACCESS_KEY_ID
            valueFrom:
              secretKeyRef:
                name: {{ s3_secret_name }}
                key: AWS_ACCESS_KEY_ID
          - name: AWS_SECRET_ACCESS_KEY
            valueFrom:
              secretKeyRef:
                name: {{ s3_secret_name }}
                key: AWS_SECRET_ACCESS_KEY
          - name: AWS_DEFAULT_REGION
            value: "{{ s3_region }}"
          - name: S3_ENDPOINT
            value: "{{ s3_endpoint }}"
          - name: S3_USE_HTTPS
            value: "{{ s3_use_https }}"
          - name: S3_VERIFY_SSL
            value: "1"
{% elif use_hf_token %}
          - name: HF_TOKEN
            valueFrom:
              secretKeyRef:
                name: {{ hf_secret_name }}
                key: HF_TOKEN
          - name: HF_HUB_ENABLE_HF_TRANSFER
            value: "0"
          - name: HF_HUB_DOWNLOAD_TIMEOUT
            value: "60"
{% endif %}
        volumeMounts:
          - name: kserve-pvc-source
            mountPath: /mnt/models
{% endif %}
    containers:
      - name: main
        image: {{ runtime_image }}
        args:
          - "--enforce-eager"
{% if enable_prefill_decode %}
          # Disaggregated mode injects an llm-d-routing-sidecar on 8000, so the
          # model server must listen on 8001. Single mode has no sidecar and
          # serves directly on KServe's default 8000.
          - "--port"
          - "8001"
{% endif %}
        securityContext:
          runAsNonRoot: false
        env:
          - name: VLLM_LOGGING_LEVEL
            value: INFO
          - name: VLLM_CPU_KVCACHE_SPACE
            value: "1"
{% if needs_storage_initializer %}
        volumeMounts:
          - name: kserve-pvc-source
            mountPath: /mnt/models
            readOnly: true
{% endif %}
        resources:
          requests:
            cpu: "500m"
            memory: "4Gi"
          limits:
            cpu: "2"
            memory: "8Gi"
{% if enable_prefill_decode %}
  prefill:
    replicas: 1
    template:
{% if needs_storage_initializer %}
      volumes:
        - name: kserve-pvc-source
          emptyDir: {}
      initContainers:
        - name: storage-initializer
          image: {{ storage_initializer_image }}
          args:
            - {{ model_uri }}
            - /mnt/models
          env:
{% if is_s3 %}
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: {{ s3_secret_name }}
                  key: AWS_ACCESS_KEY_ID
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ s3_secret_name }}
                  key: AWS_SECRET_ACCESS_KEY
            - name: AWS_DEFAULT_REGION
              value: "{{ s3_region }}"
            - name: S3_ENDPOINT
              value: "{{ s3_endpoint }}"
            - name: S3_USE_HTTPS
              value: "{{ s3_use_https }}"
            - name: S3_VERIFY_SSL
              value: "1"
{% elif use_hf_token %}
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{ hf_secret_name }}
                  key: HF_TOKEN
            - name: HF_HUB_ENABLE_HF_TRANSFER
              value: "0"
            - name: HF_HUB_DOWNLOAD_TIMEOUT
              value: "60"
{% endif %}
          volumeMounts:
            - name: kserve-pvc-source
              mountPath: /mnt/models
{% endif %}
      containers:
        - name: main
          image: {{ runtime_image }}
          args:
            - "--enable-chunked-prefill"
          securityContext:
            runAsNonRoot: false
          env:
            - name: VLLM_LOGGING_LEVEL
              value: INFO
            - name: VLLM_CPU_KVCACHE_SPACE
              value: "1"
{% if needs_storage_initializer %}
          volumeMounts:
            - name: kserve-pvc-source
              mountPath: /mnt/models
              readOnly: true
{% endif %}
          resources:
            requests:
              cpu: "500m"
              memory: "4Gi"
            limits:
              cpu: "2"
              memory: "8Gi"
{% endif %}
