      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "sum(increase(controller_runtime_reconcile_errors_total{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_unit=~\"$juju_unit\"}[5m])) + sum(increase(controller_runtime_terminal_reconcile_errors_total{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_unit=~\"$juju_unit\"}[5m]))",
