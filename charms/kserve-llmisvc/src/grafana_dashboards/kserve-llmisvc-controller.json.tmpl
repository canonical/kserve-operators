    {
      "datasource": "${prometheusds}",
      "description": "Distinct models currently exposing vLLM metrics — a proxy for active LLMInferenceService workloads (not a literal CR count).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "count(group by (model_name) (vllm:num_requests_running{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\"}))",
          "legendFormat": "models",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Serving models",
      "type": "stat"
    },
    {
      "datasource": "${prometheusds}",
      "description": "Scrape health of the llmisvc controller and workload-aggregated targets (1 = up).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "label_replace(up{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",juju_unit=~\"$juju_unit\",k8s_pod_name=\"\",job=~\".+llmisvc-(controller|workload-aggregated)-[0-9]+\"}, \"target\", \"$1\", \"job\", \".*llmisvc-([a-z]+).*\")",
          "legendFormat": "{{target}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Scrape targets up",
      "type": "stat"
    },
    {
      "datasource": "${prometheusds}",
      "description": "Leader election status per unit (1 = current leader).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 1 }
            ]
