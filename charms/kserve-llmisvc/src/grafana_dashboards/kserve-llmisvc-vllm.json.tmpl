{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "${prometheusds}",
      "description": "Requests currently running in the engine, summed across selected workers.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "sum(vllm:num_requests_running{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",model_name=~\"$model_name\",k8s_pod_name=~\"$pod\"})",
          "legendFormat": "running",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Running requests",
      "type": "stat"
    },
    {
      "datasource": "${prometheusds}",
      "description": "Requests waiting in the queue to be scheduled.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "sum(vllm:num_requests_waiting{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",model_name=~\"$model_name\",k8s_pod_name=~\"$pod\"})",
          "legendFormat": "waiting",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Waiting requests",
      "type": "stat"
    },
    {
      "datasource": "${prometheusds}",
      "description": "Peak KV cache utilisation across selected workers (1.0 = full).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.95 }] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "max(vllm:kv_cache_usage_perc{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",model_name=~\"$model_name\",k8s_pod_name=~\"$pod\"})",
          "legendFormat": "kv cache",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "KV cache usage (peak)",
      "type": "stat"
    },
    {
      "datasource": "${prometheusds}",
      "description": "Prefix cache hit ratio over the last 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "green", "value": 0.6 }] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.3",
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "sum(rate(vllm:prefix_cache_hits_total{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",model_name=~\"$model_name\",k8s_pod_name=~\"$pod\"}[5m])) / clamp_min(sum(rate(vllm:prefix_cache_queries_total{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",model_name=~\"$model_name\",k8s_pod_name=~\"$pod\"}[5m])), 1)",
          "legendFormat": "hit ratio",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Prefix cache hit ratio",
      "type": "stat"
    },
    {
      "datasource": "${prometheusds}",
      "description": "Running vs waiting requests per worker pod (prefill and decode).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "requests", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "sum by (k8s_pod_name) (vllm:num_requests_running{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",model_name=~\"$model_name\",k8s_pod_name=~\"$pod\"})",
          "legendFormat": "running: {{k8s_pod_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": "${prometheusds}",
          "editorMode": "code",
          "expr": "sum by (k8s_pod_name) (vllm:num_requests_waiting{juju_application=~\"$juju_application\",juju_model=~\"$juju_model\",juju_model_uuid=~\"$juju_model_uuid\",model_name=~\"$model_name\",k8s_pod_name=~\"$pod\"})",
          "legendFormat": "waiting: {{k8s_pod_name}}",
          "range": true,
          "refId": "B"
        }
